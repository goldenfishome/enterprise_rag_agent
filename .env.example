# .env.example
# 复制为 .env 并填入真实值

# OpenAI
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxx
EMBEDDING_MODEL=text-embedding-3-large

# Cohere (Reranking)
COHERE_API_KEY=xxxxxxxxxxxxxxxx

# Qdrant 向量数据库
QDRANT_URL=http://localhost:6333

# Redis 缓存
REDIS_URL=redis://localhost:6379

# 服务配置
PORT=8000
WORKERS=4
LOG_LEVEL=info
